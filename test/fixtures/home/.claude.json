{
  "numStartups": 3,
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE0TEST0TOKEN0DO0NOT0USE0000000000"
      }
    },
    "pinned-ok": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2025.4.25"
      ]
    }
  },
  "projects": {
    "/work/app": {
      "mcpServers": {
        "latest-tag": {
          "command": "npx",
          "args": [
            "-y",
            "some-mcp-server@latest"
          ]
        }
      }
    }
  }
}